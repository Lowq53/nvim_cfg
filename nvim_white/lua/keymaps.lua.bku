vim.keymap.set("n", "<A-q>", function()
  if vim.bo.buftype == "terminal" then
    vim.cmd("bw!")
  else
    vim.cmd("wq!") -- zamyka terminal
    -- vim.cmd("wq!") -- normal bufor
    vim.keymap.set("n", "<A-q>", ":wq!<CR>", { noremap = true, silent = true })
  end
end, { noremap = true, silent = true })

