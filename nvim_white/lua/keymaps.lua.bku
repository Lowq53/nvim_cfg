-- Mapowanie klawisza F9 do przeładowania konfiguracji
-- =======
---- Mapowanie klawiszy do funkcji przeładowania

local function reload_config()
  -- vim.keymap.set("n", "<F9>", function()
  -- vim.keymap.set('n', '<leader>R', function()
  -- Zapisz wszystkie zmienione pliki

  --  -- Wyczyść załadowane moduły z folderu lua/ mpt wprlomg
  --  for name, _ in pairs(package.loaded) do
  --    if name:match("^user") then -- tylko moduły z twojej konfiguracji
  --      package.loaded[name] = nil
  --    end
  --  end
  -- Mapowanie klawisza (np. <leader>R) do przeładowania
  -- 1. Zapisz wszystkie bufory (opcjonalne)
  vim.cmd("wall")

  -- 2. Wyczyść cache Lazy i przeładuj pluginy
  require("lazy.core.cache").reset()
  -- require("lazy").setup()

  -- 3. Przeładuj moduły konfiguracyjne (np. keymaps.lua, settings.lua)
  for name, _ in pairs(package.loaded) do
    if name:match("^user%.") or name:match("^core%.") then -- Dostosuj do swojej struktury
      package.loaded[name] = nil
    end
  end

  -- 4. Przeładuj init.lua
  vim.cmd("source $MYVIMRC")

  -- 5. Zaktualizuj which-key (kluczowy krok!)
  if pcall(require, "which-key") then
    require("which-key").register(require("which-key").plugins) -- Wymuś aktualizację
  end
  vim.notify('Reload Neovim config', vim.log.levels.INFO)
  -- end, { desc = '[R]eload config' })
  -- =======
  -- Załaduj ponownie init.lua lub główny plik
  --  dofile(vim.fn.stdpath("config") .. "/init.lua")
  -- Informacja dla użytkownika
  --  vim.notify("🔄 Konfiguracja przeładowana!", vim.log.levels.INFO)
end

